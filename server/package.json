{
  "name": "medivault-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MediVault API server",
  "scripts": {
    "dev": "nodemon --watch src -e js,json --exec \"node --env-file-if-exists=.env src/server.js\"",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed:demo": "node --env-file-if-exists=.env src/scripts/seedDemo.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.23",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.2.0",
    "fuzzball": "^2.2.6",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
