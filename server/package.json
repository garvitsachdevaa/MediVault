{
  "name": "medivault-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MediVault API server",
  "scripts": {
    "dev": "nodemon --watch src -e js,json --exec \"node --env-file-if-exists=.env src/server.js\"",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
